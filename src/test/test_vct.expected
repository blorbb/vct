FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p2))

MCNF:
[{ cpls = [[+3]]; boxes = [(3, +4); (3, +1)]; dias = [(3, -2)] };
  { cpls = [[-4; -1; +2]]; boxes = []; dias = [] }]

UNSAT:
Jr {v = [3]; dia = (3, -2); jump = Id {a = [+1; +4; -2]};
  restart = Id {a = []}}


FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p3))

MCNF:
[{ cpls = [[+4]]; boxes = [(4, +5); (4, +1)]; dias = [(4, -3)] };
  { cpls = [[-5; -1; +2]]; boxes = []; dias = [] }]

SAT:
{ v = [4]; c = [{ v = [1; 2; 5]; c = [] }] }


FORMULA: []false

MCNF:
[{ cpls = [[+1]]; boxes = [(1, +2)]; dias = [] };
  { cpls = [[-2; +0]; [-2; -0]]; boxes = []; dias = [] }]

SAT:
{ v = [1]; c = [] }


FORMULA: []p1 & <>~p1

MCNF:
[{ cpls = [[+2]]; boxes = [(2, +1)]; dias = [(2, -1)] }]

UNSAT:
Jr {v = [2]; dia = (2, -1); jump = Id {a = [+1; -1]}; restart = Id {a = []}}


FORMULA: <>p1 & <>~p1

MCNF:
[{ cpls = [[+2]]; boxes = []; dias = [(2, +1); (2, -1)] }]

SAT:
{ v = [2]; c = [{ v = []; c = [] }; { v = [1]; c = [] }] }


FORMULA: ~(<>(p1 | p2) <-> (<>p1 | <>p2))

MCNF:
[{ cpls = [[+3]; [-3; +4; +5]; [-5; +7; +8]];
   boxes = [(4, -1); (4, -2); (5, +9)]; dias = [(4, +6); (7, +1); (8, +2)] };
  { cpls = [[-6; +1; +2]; [-9; -1]; [-9; -2]]; boxes = []; dias = [] }]

UNSAT:
Jr {v = [3; 4]; dia = (4, +6); jump = Id {a = [-2; -1; +6]};
  restart =
  Jr {v = [3; 5; 7]; dia = (7, +1); jump = Id {a = [+9; +1]};
    restart =
    Jr {v = [3; 5; 8]; dia = (8, +2); jump = Id {a = [+9; +2]};
      restart = Id {a = []}}}}


