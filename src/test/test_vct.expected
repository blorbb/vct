FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p2))

MCNF:
[{ cpls = [[+3]]; boxes = [(3, +4); (3, +1)]; dias = [(3, -2)] };
  { cpls = [[-4; +5; +6]; [-5; -1]; [-6; +2]]; boxes = []; dias = [] }]

UNSAT:
Jr {v = [3]; dia = (3, -2); jump = Id {a = [+1; +4; -2]};
  restart = Id {a = []}}


FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p3))

MCNF:
[{ cpls = [[+4]]; boxes = [(4, +5); (4, +1)]; dias = [(4, -3)] };
  { cpls = [[-5; +6; +7]; [-6; -1]; [-7; +2]]; boxes = []; dias = [] }]

SAT:
{ v = [4]; c = [{ v = [1; 2; 5; 7]; c = [] }] }


FORMULA: []false

MCNF:
[{ cpls = [[+1]]; boxes = [(1, +2)]; dias = [] };
  { cpls = [[-2; +0]; [-2; -0]]; boxes = []; dias = [] }]

SAT:
{ v = [1]; c = [] }


FORMULA: []p1 & <>~p1

MCNF:
[{ cpls = [[+2]]; boxes = [(2, +1)]; dias = [(2, -1)] }]

UNSAT:
Jr {v = [2]; dia = (2, -1); jump = Id {a = [+1; -1]}; restart = Id {a = []}}


FORMULA: <>p1 & <>~p1

MCNF:
[{ cpls = [[+2]]; boxes = []; dias = [(2, +1); (2, -1)] }]

SAT:
{ v = [2]; c = [{ v = []; c = [] }; { v = [1]; c = [] }] }


FORMULA: ~(<>(p1 | p2) <-> (<>p1 | <>p2))

MCNF:
[{ cpls = [[+3]; [-3; +4; +5]; [-5; +9; +10]];
   boxes = [(4, -1); (4, -2); (5, +11)]; dias = [(4, +6); (9, +1); (10, +2)]
   };
  { cpls = [[-6; +7; +8]; [-7; +1]; [-8; +2]; [-11; -1]; [-11; -2]];
    boxes = []; dias = [] }
  ]

UNSAT:
Jr {v = [3; 4]; dia = (4, +6); jump = Id {a = [-2; -1; +6]};
  restart =
  Jr {v = [3; 5; 9]; dia = (9, +1); jump = Id {a = [+11; +1]};
    restart =
    Jr {v = [3; 5; 10]; dia = (10, +2); jump = Id {a = [+11; +2]};
      restart = Id {a = []}}}}


