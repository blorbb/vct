FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p2))

MCNF:
[{ cpls = [[+4]]; boxes = [(4, +5); (4, +2)]; dias = [(4, -3)] };
  { cpls = [[-5; -2; +3]]; boxes = []; dias = [] }]

UNSAT:
Jr {v = [4]; dia = (4, -3); jump = Local {a = [+2; +5; -3]};
  restart = Local {a = []}}


FORMULA: ~([](p1 -> p2) -> ([]p1 -> []p3))

MCNF:
[{ cpls = [[+5]]; boxes = [(5, +6); (5, +2)]; dias = [(5, -4)] };
  { cpls = [[-6; -2; +3]]; boxes = []; dias = [] }]

SAT:
{ v = [5]; c = [{ v = [2; 3; 6]; c = [] }] }


FORMULA: []false

MCNF:
[{ cpls = [[+2]]; boxes = [(2, +3)]; dias = [] };
  { cpls = [[-3; +1]; [-3; -1]]; boxes = []; dias = [] }]

SAT:
{ v = [2]; c = [] }


FORMULA: []p1 & <>~p1

