[{ cpls = [[+3]]; boxes = [(3, +2)]; dias = [(3, -2)] }]

UNSAT:
Jr {v = [3]; dia = (3, -2); jump = Local {a = [+2; -2]};
  restart = Local {a = []}}


FORMULA: <>p1 & <>~p1

MCNF:
[{ cpls = [[+3]]; boxes = []; dias = [(3, +2); (3, -2)] }]

SAT:
{ v = [3]; c = [{ v = []; c = [] }; { v = [2]; c = [] }] }


FORMULA: ~(<>(p1 | p2) <-> (<>p1 | <>p2))

MCNF:
[{ cpls = [[+4]; [-4; +5; +6]; [-6; +8; +9]];
   boxes = [(5, -2); (5, -3); (6, +10)]; dias = [(5, +7); (8, +2); (9, +3)] };
  { cpls = [[-7; +2; +3]; [-10; -2]; [-10; -3]]; boxes = []; dias = [] }]

UNSAT:
Jr {v = [4; 5]; dia = (5, +7); jump = Local {a = [-3; -2; +7]};
  restart =
  Jr {v = [4; 6; 8]; dia = (8, +2); jump = Local {a = [+10; +2]};
    restart =
    Jr {v = [4; 6; 9]; dia = (9, +3); jump = Local {a = [+10; +3]};
      restart = Local {a = []}}}}


